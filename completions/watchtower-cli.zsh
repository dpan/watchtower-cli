#compdef watchtower-cli
# @generated by usage-cli from watchtower.usage.kdl
local curcontext="$curcontext"

_watchtower_cli() {
  emulate -L zsh
  typeset -A opt_args
  local curcontext="$curcontext" cache_policy

  if ! type -p usage &> /dev/null; then
      echo >&2
      echo "Error: usage CLI not found. This is required for completions to work in watchtower-cli." >&2
      echo "See https://usage.jdx.dev for more information." >&2
      return 1
  fi

  local spec_dir="${XDG_CACHE_HOME:-$HOME/.cache}/usage"
  [[ -d "$spec_dir" ]] || mkdir -p -m 700 "$spec_dir"
  local spec_file="$spec_dir/usage__usage_spec_watchtower_cli.spec"
  cat >| "$spec_file" <<'__USAGE_EOF__'
name watchtower-cli
bin watchtower-cli
version "0.1.0-dev"
about "Command-line client for the Watchtower HTTP API (v1.21.0)"
flag --url help="Watchtower HTTP API base URL" global=#true env=WATCHTOWER_HTTP_API_URL {
    arg <url>
}
flag "-t --target" help="Named target from targets.toml" global=#true {
    arg <name>
}
flag --token help="API token sent as Authorization: Bearer" global=#true env=WATCHTOWER_HTTP_API_TOKEN {
    arg <token>
}
flag --events-token help="Token for GET /v1/events (separate from the API token)" global=#true env=WATCHTOWER_HTTP_API_EVENTS_TOKEN {
    arg <token>
}
flag --timeout help="HTTP client timeout" global=#true default="10m" {
    arg <duration>
}
flag "-k --insecure" help="Skip TLS certificate verification" global=#true
cmd update help="Trigger container updates (POST /v1/update)" effect=write {
    flag "-i --image" help="Filter by image name (repeatable)" {
        arg <image>
    }
    flag "-c --container" help="Filter by container name or regex (repeatable)" {
        arg <container>
    }
    flag --async help="Run the update in the background (HTTP 202)"
    flag --api-timeout help="Watchtower handler timeout override (query param timeout)" {
        arg <duration>
    }
}
cmd check help="Check for available updates without applying them (POST /v1/check)" effect=read {
    flag "-i --image" help="Filter by image name (repeatable)" {
        arg <image>
    }
    flag "-c --container" help="Filter by container name or regex (repeatable)" {
        arg <container>
    }
    flag --api-timeout help="Watchtower handler timeout override (query param timeout)" {
        arg <duration>
    }
}
cmd containers help="List watched containers (GET /v1/containers)" effect=read {
    flag "-n --name" help="Filter by exact container name (repeatable)" {
        arg <name>
    }
    flag "-i --image" help="Filter by image name (repeatable)" {
        arg <image>
    }
    cmd details help="Detailed container status (GET /v1/containers/details)" {
        flag "-n --name" help="Filter by exact container name (repeatable)" {
            arg <name>
        }
        flag "-i --image" help="Filter by image name (repeatable)" {
            arg <image>
        }
    }
}
cmd history help="Scan history from the in-memory ring buffer (GET /v1/history)" effect=read {
    flag --since help="RFC3339 timestamp; entries at or after" {
        arg <timestamp>
    }
    flag --until help="RFC3339 timestamp; entries at or before" {
        arg <timestamp>
    }
    flag --limit help="Maximum number of entries" {
        arg <n>
    }
}
cmd images help="List tracked images (GET /v1/images)" effect=read {
    flag "-n --name" help="Filter by exact image name (repeatable)" {
        arg <name>
    }
    flag --id help="Filter by image ID (repeatable)" {
        arg <id>
    }
}
cmd config help="Show the active Watchtower configuration (GET /v1/config)" effect=read
cmd status help="Summary of the most recent scan (GET /v1/status)" effect=read
cmd metrics help="Prometheus metrics (GET /v1/metrics)" effect=read
cmd events help="Stream operational events via SSE (GET /v1/events)" effect=read
cmd probe help="TCP connectivity check against the API URL (does not send a token)" effect=read
cmd health help="Watchtower health probes" effect=read {
    cmd live help="Liveness probe (GET /livez)" {
        alias liveness
    }
    cmd ready help="Readiness probe (GET /readyz)" {
        alias readiness
    }
    cmd startup help="Startup probe (GET /startupz)"
}
__USAGE_EOF__
  local -a values=() descs=() inserts=()
  local needs_menu=0 line
  while IFS= read -r line; do
    local -a parts=("${(@ps:\t:)line}")
    values+=("${parts[1]}")
    descs+=("${parts[2]}")
    inserts+=("${parts[3]}")
    [[ "${parts[3]}" == "'"* ]] && needs_menu=1
  done < <(command usage complete-word --shell zsh -f "$spec_file" -- "${(Q)words[@]}")
  (( needs_menu )) && compstate[insert]=menu
  if (( ${#inserts[@]} )); then
    local -a _usage_display=()
    local _usage_i _usage_max=0 _usage_v _usage_pad
    for _usage_v in "${values[@]}"; do
      (( ${#_usage_v} > _usage_max )) && _usage_max=${#_usage_v}
    done
    for ((_usage_i=1; _usage_i<=${#values[@]}; _usage_i++)); do
      if [[ -n "${descs[_usage_i]}" ]]; then
        _usage_pad=$(( _usage_max - ${#values[_usage_i]} ))
        _usage_display+=("${values[_usage_i]}${(l:_usage_pad:: :)}  -- ${descs[_usage_i]}")
      else
        _usage_display+=("${values[_usage_i]}")
      fi
    done
    compadd -l -d _usage_display -U -Q -S '' -a inserts
  fi
  return 0
}

if [ "$funcstack[1]" = "_watchtower_cli" ]; then
    _watchtower_cli "$@"
else
    compdef _watchtower_cli watchtower-cli
fi

